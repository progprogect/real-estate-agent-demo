generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  AGENT
  ADMIN
}

enum VisitStatus {
  PENDING
  REMINDER_SENT
  DRAFT
  ANSWERED
  EXPIRED
  CANCELLED
}

enum SubmissionStatus {
  PENDING
  DELIVERED
  FAILED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role       @default(AGENT)
  branch       String?
  zohoUserId   String?    @unique
  createdAt    DateTime   @default(now())
  visits       Visit[]
  auditLogs    AuditLog[]
}

model CriterionConfig {
  id    String @id @default(cuid())
  /// Stable identifier sent to the agency endpoint. Generated once, never edited.
  key   String @unique
  label String
  /// Optional description; it is what the AI is told to look for and what the
  /// agent sees under "Points to cover".
  hint  String @default("")
  /// "text" | "rating" | "choice"
  type      String   @default("text")
  /// Allowed values when type is "choice"
  options   String[] @default([])
  /// Upper bound when type is "rating"
  ratingMax Int      @default(5)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
}

/// Single-row-per-key application settings edited by administrators.
model AppSetting {
  key   String @id
  value String
}

model Visit {
  id            String         @id @default(cuid())
  zohoEventId   String         @unique
  zohoDealId    String?
  zohoContactId String?
  propertyRef   String
  address       String
  prospectName  String
  visitDatetime DateTime
  status        VisitStatus    @default(PENDING)
  agentId       String
  agent         User           @relation(fields: [agentId], references: [id])
  draft         FeedbackDraft?
  submission    Submission?
  recordings    Recording[]
  /// Reminder bookkeeping for the state machine; the reminders themselves are
  /// sent by the agency, we only signal.
  remindersSent  Int       @default(0)
  dueEventSentAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([agentId, status])
}

/// Log of every outbound signal to the agency's reminder engine, including the
/// ones that could not be delivered, so failures stay visible.
model WebhookEvent {
  id           String   @id @default(cuid())
  visitId      String?
  type         String
  payload      Json
  status       String
  responseCode Int?
  error        String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

/// One dictation take. Several takes accumulate on the same viewing and each
/// one can extend or correct what the earlier ones produced.
model Recording {
  id        String   @id @default(cuid())
  visitId   String
  visit     Visit    @relation(fields: [visitId], references: [id])
  /// 1-based position in the take list for this viewing
  index     Int
  /// "general" (feeds every field) or "field" (feeds one field only)
  mode      String   @default("general")
  fieldKey  String?
  verbatim  String
  durationS Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([visitId, index])
}

model FeedbackDraft {
  id              String   @id @default(cuid())
  visitId         String   @unique
  visit           Visit    @relation(fields: [visitId], references: [id])
  /// Map of criterion key -> { value, state: "filled" | "incomplete" | "missing", confirmed, editedByAgent }
  values          Json     @default("{}")
  generalFeedback String   @default("")
  verbatim        String   @default("")
  inputMode       String   @default("voice")
  audioDurationS  Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model Submission {
  id             String           @id @default(cuid())
  visitId        String           @unique
  visit          Visit            @relation(fields: [visitId], references: [id])
  idempotencyKey String           @unique
  payload        Json
  status         SubmissionStatus @default(PENDING)
  attempts       Int              @default(0)
  lastError      String?
  submittedAt    DateTime         @default(now())
  deliveredAt    DateTime?
}

/// Inbox of the mock "agency endpoint" (stands in for the Hi Folks endpoint).
model InboxEvent {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique
  payload        Json
  receivedAt     DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
